{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "farmers": {
      "$farmerId": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $farmerId || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
      }
    },
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null"
      }
    },
    "orders": {
      "$orderId": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('farmerId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
        ".write": "auth != null"
      }
    },
    "bids": {
      "$bidId": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('farmerId').val() === auth.uid || !data.exists())",
        ".write": "auth != null"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "mandiRates": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'"
    },
    "collectionCenters": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'"
    }
  }
}
