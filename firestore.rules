rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.admin == true
      );
    }
    
    function isFarmer() {
      return isAuthenticated() && (
        request.auth.token.role == 'FARMER' ||
        resource.data.farmerId == request.auth.uid
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Farmer Profiles
    match /farmers/{farmerId} {
      allow read: if true; // Public directory for transparent farmer discovery
      allow create: if isAuthenticated();
      allow update: if isOwner(farmerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Buyer Profiles
    match /buyers/{buyerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == buyerId;
      allow update: if isOwner(buyerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Products & Crop Listings
    match /products/{productId} {
      allow read: if true; // Public farmgate marketplace browsing
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        resource.data.farmer.user.id == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
    }

    // 5. Orders & Transactions
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        resource.data.deliveryPartnerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 6. Buyer Bids & Negotiation Offers
    match /bids/{bidId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.farmerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );
    }

    // 7. Live Delivery & Telemetry Checkpoints
    match /deliveries/{deliveryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        resource.data.deliveryPartnerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 9. Chat Messages between Farmer & Buyer
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 10. Collection Centers & Storage Hubs
    match /collectionCenters/{centerId} {
      allow read: if true; // Public access for farmers to find regional drop-off centers
      allow write: if isAdmin();
    }

    // 11. Government APMC Mandi Rates & Price History
    match /mandiRates/{rateId} {
      allow read: if true; // Public real-time benchmark pricing
      allow write: if isAdmin();
    }
  }
}
